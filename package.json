{
  "name": "reservaquadras",
  "version": "1.0.0",
  "description": "Uma API direcionada a permitir a reserva e visualização de reservas de quadras, inicialmente direcionado às quadras do IFNMG Campus Salinas. Projeto criado para o desenvolvimento do trabalho final da disciplina de WEB II, do curso Bacharelado em Sistemas de Informação.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "find src -name '*.js' | xargs node --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Murynga/ReservaQuadras.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Murynga/ReservaQuadras/issues"
  },
  "homepage": "https://github.com/Murynga/ReservaQuadras#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "nodemon": "^3.1.0",
    "prisma": "^6.0.0",
    "supertest": "^7.0.0",
    "vitest": "^3.0.0"
  }
}